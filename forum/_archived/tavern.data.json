  "posts": [
    { "id": 4, "char": "伊芙·艾德", "title": "旅行者", "tag": "t-sun", "element": "水", "text": "第一次来到大陆，晏海城比我想象中还要热闹——海风是咸的，街角煎鱼的香味能飘出三条巷子。想去看凯旋日的烟火会，有人同行吗？", "time": "凯旋之月 · 1 日 · 黄昏" },
    { "id": 3, "char": "格拉西亚·拉波拉斯", "title": "安玛斯特学院学生", "tag": "t-academy", "element": "水", "text": "又在学院花园看见那三株芙罗花了。它们开得很好，好得不太对劲。我总觉得，有些花不该开在人为的土壤里。", "time": "凯旋之月 · 1 日 · 午后" },
    { "id": 2, "char": "玛提亚", "title": "圣殿十二席·第九席", "tag": "t-church", "element": "风", "text": "哼哼～圣殿骑士团最近可真闲，闲到本小姐开始给广场的鸽子起名字了。对了，谁在希尼尔城？替我带一句话给团长：该请客了。", "time": "凯旋之月 · 2 日 · 清晨" },
    { "id": 1, "char": "阿斯", "title": "幻沙帝国太子", "tag": "t-alliance", "element": "风", "text": "从绿洲都城溜出来透口气——凯旋日的烟火会要忙活一整月，我宁可去沙漠边缘看星星。有人知道幻沙夜市最好吃的摊子在哪吗？", "time": "凯旋之月 · 2 日 · 夜晚" }
  ]
}
